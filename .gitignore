# Build output
/bin/
/dist/
/dkp
/dkp.exe
coverage.out
coverage.html
*.test
*.prof

# Per-checkout tool caches. golangci-lint's cache lives here rather than in the shared per-user one
# (issue #117): a result cached by another worktree carries that worktree's absolute paths, and when
# that worktree is deleted `make lint` warns about a file it cannot open — quoting, in the case that
# filed the issue, the ledger's float64 ban against internal/core/centipoints.go on a clean tree.
/.cache/

# Web build output — produced in CI and embedded in the binary
/web/dist/
/web/node_modules/
/web/.vite/
node_modules/
.pnpm-store/

# Playwright output. test-results/ holds traces and screenshots (CI uploads it on failure) plus the
# JSON report scripts/test-e2e.sh reads back to prove the run was not vacuous; .e2e-data/ is the
# throwaway SQLite directory the harness boots bin/dkp against.
/web/test-results/
/web/playwright-report/
/web/.e2e-data/

# The go:embed target for internal/ui. `make build` copies web/dist here; that real, hashed output
# is build output and must not be committed. Two committed placeholders are the exception: they are
# the compile-time fallback that keeps internal/ui buildable and TestEmbed_* runnable with no JS
# toolchain. Everything else under the directory is ignored.
/internal/ui/dist/*
/internal/ui/dist/assets/*
!/internal/ui/dist/index.html
!/internal/ui/dist/assets/
!/internal/ui/dist/assets/app-placeholder.js

# Runtime data. Never commit a guild's database.
/data/
/dkp-data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Local config and secrets
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/**/*.key

# Docs site build
/docs/.astro/
/docs/dist/
.pagefind/

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Claude Code local overrides — the shared settings.json IS committed
.claude/settings.local.json

# ---------------------------------------------------------------------------
# NOT ignored, deliberately: these generated artefacts are committed and
# diff-gated, which is what makes the drift checks work. Do not add them here.
#   openapi/openapi.json
#   internal/store/sqlitegen/
#   internal/store/pggen/
#   web/src/api/
#   clients/ts/  clients/python/
#   db/migrations-sqlite/  db/migrations-postgres/
# ---------------------------------------------------------------------------

# Build output of `make mockup-site` — assembled from docs/design/mockups/, never edited by hand.
/_site/

# Bytecode from scripts/*.py (scripts/check-links.py and scripts/verify-spec.py).
__pycache__/
