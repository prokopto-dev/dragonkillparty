/docs/.astro/
/docs/dist/
.pagefind/

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Claude Code local overrides — the shared settings.json IS committed
.claude/settings.local.json

