      "Edit(./cmd/**)",
      "Edit(./db/queries/**)",
      "Edit(./db/schema.hcl)",
      "Edit(./web/src/**)",
      "Edit(./test/**)",
      "Edit(./docs/**)",
      "Edit(./deploy/**)",
      "Edit(./scripts/**)",
