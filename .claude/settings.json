{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-protected-paths.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/scan-secrets.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format-go.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(make gen)",
      "Bash(make test-unit)",
      "Bash(make test)",
      "Bash(make test-importer)",
      "Bash(make lint)",
      "Bash(make vet)",
      "Bash(make build)",
      "Bash(make fmt)",
      "Bash(make check)",
      "Bash(make clean)",
      "Bash(make help)",
      "Bash(make docker)",
      "Bash(make migration:*)",
      "Bash(make seed:*)",
      "Bash(make verify-commands)",
      "Bash(make verify-generated)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go run ./cmd/dkp:*)",
      "Bash(go doc:*)",
      "Bash(go list:*)",
      "Bash(go env:*)",
      "Bash(go fmt:*)",
      "Bash(go version)",
      "Bash(go mod tidy)",
      "Bash(go mod verify)",
      "Bash(go mod graph)",
      "Bash(go mod why:*)",
      "Bash(go mod download)",
      "Bash(gofumpt:*)",
      "Bash(goimports:*)",
      "Bash(staticcheck:*)",
      "Bash(golangci-lint run:*)",
      "Bash(golangci-lint version)",
      "Bash(sqlc generate)",
      "Bash(sqlc vet)",
      "Bash(sqlc diff)",
      "Bash(sqlc version)",
      "Bash(atlas migrate diff:*)",
      "Bash(atlas migrate lint:*)",
      "Bash(atlas migrate validate:*)",
      "Bash(atlas migrate status:*)",
      "Bash(atlas schema inspect:*)",
      "Bash(atlas version)",
      "Bash(goose status:*)",
      "Bash(goose version)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm run build)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run test:*)",
      "Bash(pnpm run generate:client)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec vite build:*)",
      "Bash(pnpm exec vitest run:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec prettier:*)",
      "Bash(pnpm exec playwright test:*)",
      "Bash(docker build:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
