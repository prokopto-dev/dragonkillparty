      "Edit(./go.mod)",
      "Edit(./go.sum)",
      "Edit(./web/pnpm-lock.yaml)",
      "Edit(./web/package.json)",
      "Edit(./LICENSE)",
      "Edit(./CODEOWNERS)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./dkp-data/**)",
      "Read(./**/*.pem)",
