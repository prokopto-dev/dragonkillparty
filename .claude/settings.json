      "Edit(./openapi/openapi.json)",
      "Edit(./internal/store/sqlitegen/**)",
      "Edit(./internal/store/pggen/**)",
      "Edit(./web/src/api/**)",
      "Edit(./web/dist/**)",
      "Edit(./clients/ts/**)",
