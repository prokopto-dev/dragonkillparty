# The supply-chain baseline of docs/design/03-security.md section 12, for the one project in this
# repository that has a package.json. See /.npmrc for the full reasoning; the short version is that
# lifecycle scripts are the primary npm attack vector and `cd web && pnpm install` must be safe
# without anybody having to remember --ignore-scripts.
#
# THIS is the file that binds. pnpm reads the project .npmrc from the directory holding
# package.json and does not walk upward, so on pnpm 9.15.9 with no pnpm-workspace.yaml the root
# file is invisible from here:
#
#     $ pnpm config get ignore-scripts          # repo root -> true
#     $ cd web && pnpm config get ignore-scripts # without this file -> undefined
#
# Verified at adoption, which is what the design document's open assumption asked for.
#
# It does not affect `pnpm run <script>`: `pnpm run build`, `lint`, `typecheck` and `dev` all still
# execute. The setting suppresses lifecycle scripts — dependency install hooks and pre/post hooks —
# not scripts you name yourself.
#
# A dependency that genuinely needs its lifecycle script gets a reviewed
# `pnpm.onlyBuiltDependencies` entry in web/package.json naming that one package, never a blanket
# `ignore-scripts=false`. Playwright's browsers are unaffected: scripts/test-e2e.sh installs them
# with an explicit `pnpm exec playwright install chromium`, which is a command, not a hook.
#
# NEVER put a credential in this file. It is committed. test/repo/npmrc_test.go fails on one.
ignore-scripts=true
